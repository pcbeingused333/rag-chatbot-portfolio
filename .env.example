# Copy this file to .env and fill in your own values.

# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Mode ---
# DEMO_MODE=1 runs fully self-contained: small embedding model + in-memory FAISS
# index preloaded from demo/. No Postgres needed, fits a free 1 GB container.
# This is what the public demo uses. Leave unset (or 0) for the production path.
# DEMO_MODE=1

# Postgres connection string (production path only — not needed when DEMO_MODE=1).
# Must be a database with the pgvector extension. Local docker-compose default:
POSTGRES_CONNECTION=postgresql+psycopg://postgres:postgres@localhost:5432/rag_portfolio
# Hosted example (Supabase / Neon): postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- Optional overrides (sensible defaults live in rag_core.py) ---
# LLM_MODEL=llama-3.3-70b-versatile
# EMBEDDING_MODEL=BAAI/bge-m3          # demo default: sentence-transformers/all-MiniLM-L6-v2
# COLLECTION_NAME=pdf_documents
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_K=7
