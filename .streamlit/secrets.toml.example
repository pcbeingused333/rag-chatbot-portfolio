# Copy to .streamlit/secrets.toml for local runs, or paste the contents into
# Streamlit Community Cloud under Advanced settings -> Secrets.
#
# app.py copies every key here into os.environ before importing rag_core, so the
# same variables work locally via .env and in the cloud via this file.

# Groq API key — free at https://console.groq.com/keys
GROQ_API_KEY = "gsk_your_key_here"

# Self-contained demo: in-memory FAISS + small embedding model, knowledge base
# preloaded from demo/. No database needed. This is what the public demo uses.
DEMO_MODE = "1"

# --- Production path only (omit these when DEMO_MODE = "1") ---
# POSTGRES_CONNECTION = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME"

# --- Optional overrides ---
# LLM_MODEL = "openai/gpt-oss-120b"
